# Ce chemin est lu côté serveur ; aucune clé n'est copiée.
EXTERNAL_ENV_FILE=../fastapi-text2sql/eval/.env
PORT=4310
# Overrides facultatifs : TEXT2SQL_BASE_URL, OPENAI_MODEL, TRANSCRIPTION_MODEL.
# OPENAI_API_KEY et TEXT2SQL_API_KEY peuvent aussi venir de l'environnement.
# Pour une compilation sous un préfixe, exporter BASE_PATH avant npm run build.
# BASE_PATH=/hors-champ/
# PUBLIC_ORIGIN=https://www.vaugouin.com
# Le VPS utilise compose.yaml et scripts/configure-vps.sh, pas ce chemin local.
